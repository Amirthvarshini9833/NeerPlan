# Copy this file to .env.local for local-only configuration.
NEXT_PUBLIC_APP_NAME=NeerPlan
# Local SQLite default:
DATABASE_URL="file:./dev.db"
# PostgreSQL deployment example (use this with prisma/schema.postgresql.prisma):
# DATABASE_URL="postgresql://USER:PASSWORD@POOLER-HOST:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://USER:PASSWORD@DIRECT-HOST:5432/postgres"
# Local default. On Vercel Production, use your canonical HTTPS domain.
NEXTAUTH_URL="http://localhost:3000"
# Generate a long random value, for example with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
