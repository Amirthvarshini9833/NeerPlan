{
  "name": "neerplan",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.9.0 <25",
    "pnpm": ">=11.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:postgres:generate": "prisma generate --schema prisma/postgresql/schema.prisma",
    "db:postgres:migrate-deploy": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "db:postgres:push": "prisma db push --schema prisma/postgresql/schema.prisma",
    "build:vercel": "prisma generate --schema prisma/postgresql/schema.prisma && next build"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "next": "latest",
    "next-auth": "^4.24.15",
    "react": "latest",
    "react-dom": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "prisma": "^6.19.2",
    "tailwindcss": "^4.3.3",
    "typescript": "latest"
  }
}
